<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinHardeningAudit_App.Pages.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Category" />
        <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ToggleButton x:Name="OnlyOpenToggle" x:Uid="OnlyOpenToggle" Content="Open only" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <ToggleButton x:Name="OnlySevereToggle" x:Uid="OnlySevereToggle" Content="Critical/High only" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <TextBox x:Name="SearchBox" x:Uid="SearchBox" Width="280" PlaceholderText="Search …" TextChanged="Filter_Changed" />
            <ComboBox x:Name="SortBox" x:Uid="SortBox" Header="Sort order" SelectionChanged="Filter_Changed_Selection" MinWidth="180" />
            <Button x:Name="BulkButton" Click="BulkButton_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ListView x:Name="ResultList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="Bold" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel Spacing="4" MaxWidth="900">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Meta}" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Details}" TextWrapping="Wrap" />
                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding LabelDesc}" FontWeight="SemiBold"/><Run Text="{Binding Description}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding LabelActual}" FontWeight="SemiBold"/><Run Text="{Binding Actual}" /><Run Text="{Binding LabelExpected}" FontWeight="SemiBold"/><Run Text="{Binding Expected}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding LabelFix}" FontWeight="SemiBold"/><Run Text="{Binding Fix}" /></TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding FixButton}" Tag="{Binding RuleId}" Click="FixButton_Click" Visibility="{Binding FixVisible}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="{Binding UndoButton}" Tag="{Binding RuleId}" Click="UndoButton_Click" Visibility="{Binding UndoVisible}" />
                                    <Button Content="{Binding GuideButton}" Tag="{Binding RuleId}" Click="GuideButton_Click" Visibility="{Binding GuideVisible}" />
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding FixNote}" TextWrapping="Wrap" Visibility="{Binding FixNoteVisible}" />
                                <TextBlock TextWrapping="Wrap" FontStyle="Italic"><Run Text="{Binding NotizZeile}" /></TextBlock>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
