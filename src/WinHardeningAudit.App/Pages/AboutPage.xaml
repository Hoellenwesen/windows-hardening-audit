<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinHardeningAudit_App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="900">
            <TextBlock x:Uid="AboutTitle" Style="{StaticResource TitleTextBlockStyle}" Text="About – Best Practices &amp; Sources" />
            <TextBlock x:Uid="AboutIntro" TextWrapping="Wrap" Text="This app reads the local hardening state and compares it against recognized best practices." />

            <TextBlock x:Uid="AboutSourcesHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Best practices used" />

            <StackPanel Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="CIS Microsoft Windows 11 Benchmark v5.x (Center for Internet Security)" TextWrapping="Wrap" />
                <TextBlock x:Uid="AboutCisBody" TextWrapping="Wrap" Text="Level 1: essential hardening. Level 2: defense-in-depth. (cisecurity.org/cis-benchmarks)" />
            </StackPanel>

            <StackPanel Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Microsoft Security Baseline, Windows 11 v25H2" TextWrapping="Wrap" />
                <TextBlock x:Uid="AboutMsBody" TextWrapping="Wrap" Text="Machine-imported from the Security Compliance Toolkit. (aka.ms/SCT)" />
            </StackPanel>

            <StackPanel Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="DISA Windows 11 STIG (Defense Information Systems Agency, public domain)" TextWrapping="Wrap" />
                <TextBlock x:Uid="AboutStigBody" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Cross-reference for target values and severity classification. (cyber.mil/STIGs)" />
            </StackPanel>

            <TextBlock x:Uid="AboutMethodHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Methodology" />
            <TextBlock x:Uid="AboutMethodBody" TextWrapping="Wrap" Text="Severities and status values as used throughout the app." />
            <TextBlock x:Uid="AboutRulesNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Note: rule texts are currently only available in German." />
        </StackPanel>
    </ScrollViewer>
</Page>
