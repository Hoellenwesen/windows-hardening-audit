<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinHardeningAudit_App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="14" MaxWidth="1200">
            <TextBlock x:Uid="DashTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Dashboard – Security Hardening Status" />
            <TextBlock x:Name="StatusLine" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No scan yet." />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ScanButton" x:Uid="ScanButton" Content="Scan now" Click="ScanButton_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="CancelButton" x:Uid="CancelButton" Content="Cancel" Click="CancelButton_Click" IsEnabled="False" />
                <ProgressRing x:Name="ScanProgress" IsActive="False" Width="28" Height="28" />
                <ComboBox x:Name="ProfileBox" x:Uid="ProfileBox" Header="Profile" SelectionChanged="ProfileBox_Changed" MinWidth="240">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="ProfileTip" Content="CIS = Center for Internet Security Benchmark." />
                    </ToolTipService.ToolTip>
                </ComboBox>
                <ComboBox x:Name="TargetBox" x:Uid="TargetBox" Header="Target" SelectionChanged="TargetBox_Changed" MinWidth="140" />
            </StackPanel>

            <InfoBar
                x:Name="L2Banner"
                x:Uid="L2Banner"
                Title="CIS Level 2 preview"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False" />

            <Grid x:Name="ScoreGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                    <TextBlock x:Uid="ScoreLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Score" />
                    <TextBlock x:Name="ScoreText" FontSize="32" FontWeight="Bold" Text="–" />
                </StackPanel>
                <StackPanel Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                    <TextBlock x:Uid="PassFailLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Passed / Open" />
                    <TextBlock x:Name="PassFailText" FontSize="32" FontWeight="Bold" Text="–" />
                </StackPanel>
                <StackPanel Grid.Column="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                    <TextBlock x:Uid="CritLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Critical open" />
                    <TextBlock x:Name="CritText" FontSize="32" FontWeight="Bold" Foreground="#C42B1C" Text="–" />
                </StackPanel>
                <StackPanel Grid.Column="3" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                    <TextBlock x:Uid="HighLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="High open" />
                    <TextBlock x:Name="HighText" FontSize="32" FontWeight="Bold" Foreground="#8A5A00" Text="–" />
                </StackPanel>
            </Grid>

            <TextBlock x:Uid="TopRisksHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Top risks (open, by severity)" />
            <ListView x:Name="TopRisksList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,6" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Uid="SearchHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Global search (all categories)" />
            <TextBox x:Name="GlobalSearchBox" x:Uid="GlobalSearchBox" PlaceholderText="e.g. BitLocker, firewall, SMB …" TextChanged="GlobalSearch_Changed" />
            <ListView x:Name="GlobalSearchList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GlobalSearch_ItemClick" MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,6" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Uid="CategoriesHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="Categories" />
            <GridView x:Name="CategoryGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CategoryGrid_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="280" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{Binding Counts}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
