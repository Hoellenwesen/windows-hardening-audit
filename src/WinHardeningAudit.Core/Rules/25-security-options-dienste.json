    "description": "Rechtlicher Hinweis vor der Anmeldung (Titel und Text gesetzt).",
    "category": "accounts-uac",
    "source": "CIS",
    "sourceId": "CIS 2.3.7.4 / 2.3.7.5 (L1)",
    "severity": 1,
    "check": {
      "provider": "script",
      "operator": "Equals",
      "expected": "Gesetzt",
      "script": "$c = (Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' -ErrorAction SilentlyContinue).legalnoticecaption; $t = (Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' -ErrorAction SilentlyContinue).legalnoticetext; if ([string]::IsNullOrWhiteSpace($c) -or [string]::IsNullOrWhiteSpace($t)) { 'Leer' } else { 'Gesetzt' }"
    },
    "fixHint": "secpol.msc > Sicherheitsoptionen > Interaktive Anmeldung: Meldungstext/-titel für Anmeldeversuche festlegen.",
    "remediation": {"mode":"manual","risk":"low","gui":"secpol.msc > Sicherheitsoptionen > Interaktive Anmeldung: Titel/Text für Benutzer bei der Anmeldung","steps":["secpol.msc > Lokale Richtlinien > Sicherheitsoptionen > Interaktive Anmeldung: Titel und Text für Benutzer bei der Anmeldung festlegen (Rechts-/Organisationsvorgaben beachten).","PowerShell (Admin): New-ItemProperty HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name legalnoticecaption -Value <Titel> -PropertyType String -Force; analog legalnoticetext.","Prüfen: erneut scannen (Fund verlangt einen gesetzten, nicht-leeren Hinweistext)."]},
