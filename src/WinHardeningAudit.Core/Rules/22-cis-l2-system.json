[
  {
    "id": "L2S-01",
    "title": "SMBv1-Server deaktiviert",
    "description": "Der veraltete SMBv1-Serverdienst muss deaktiviert sein (Server-Seite).",
    "category": "firewall-network",
    "source": "CIS Level 2 + STIG",
    "sourceId": "CIS L2 / STIG SV-253287",
    "severity": 3,
    "check": {
      "provider": "registry",
      "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
      "valueName": "SMB1",
      "operator": "Equals",
      "expected": "0"
    },
    "fixHint": "SMB1-Serverfeature entfernen bzw. SMB1=0 (DWORD). Client-Seite siehe NET-04.",
    "profil": "L2",
    "kapitel": "CIS L2 (SMB)",
    "giltAb": "24H2",
    "ziel": "both"
  },
